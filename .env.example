# Supabase → Project settings → Database → Connection string (use the pooler URI, port 6543, for Vercel)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Supabase → Project settings → API → JWT secret (server-side only, never expose to the browser)
SUPABASE_JWT_SECRET=replace-me
