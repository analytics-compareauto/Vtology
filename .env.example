# Supabase → Connect (top bar) → Connection String → "Transaction pooler" (port 6543). Put your database password in place of [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# The project URL shown on the Supabase project home page.
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase → Project Settings → API Keys → Publishable key (starts with sb_publishable_). Needed for sign-in.
SUPABASE_PUBLISHABLE_KEY=
# Optional: the database password on its own (overrides any password in DATABASE_URL; DATABASE_URL can then be left out).
DATABASE_PASSWORD=
# Optional: only needed if your project still signs tokens with the legacy JWT secret.
SUPABASE_JWT_SECRET=

# ---- Social accounts (v0.3) ----
# Any long random text (40+ characters). Encrypts stored platform access keys. Keep a copy; changing it disconnects accounts.
VTOLOGY_SECRET_KEY=
# Meta app (developers.facebook.com → your app → App settings → Basic). Redirect URI: https://vtology.vercel.app/api/social/callback/meta
META_APP_ID=
META_APP_SECRET=
# Optional: only if Meta asks for a Facebook Login for Business configuration
META_CONFIG_ID=
# Google OAuth client (console.cloud.google.com → Credentials). Redirect URI: https://vtology.vercel.app/api/social/callback/youtube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: protects the daily sync job (Vercel sends it automatically when set)
CRON_SECRET=
