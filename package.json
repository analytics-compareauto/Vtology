{
  "name": "vtology",
  "private": true,
  "version": "0.1.0",
  "description": "Vtology: an operational ontology for the acquisition-to-sales pipeline in Automotive, BFSI and FMCG.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "migrations:embed": "node scripts/embed-migrations.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^22.10.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
